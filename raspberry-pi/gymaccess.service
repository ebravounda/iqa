[Unit]
Description=IngresoQR Access Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/gymaccess
# Ensure no stale instance is holding the GPIO/USB devices before we start.
# `|| true` so the service starts even when there is nothing to kill.
ExecStartPre=/bin/sh -c '/usr/bin/pkill -9 -f access_control.py || true; /bin/sleep 3'
ExecStart=/home/pi/gymaccess-env/bin/python3 /home/pi/gymaccess/access_control.py
Restart=always
RestartSec=5
# Wait a bit longer between automatic restarts so GPIO/USB can release.
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
